{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salon-white1",
  "main": "./worker.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "binding": "ASSETS",
    "directory": ".",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/assets/images/*"]
  },
  "observability": {
    "enabled": true
  }
}
